@inject LanguageService LangSvc
@implements IDisposable

<section class="section" id="techstack">
    <div class="container">
        <h2 class="section-title">@LangSvc.Get("techstack.title")</h2>
        <div class="section-title-line"></div>

        @foreach (var group in GetTechGroups())
        {
            <div class="tech-group">
                <h3 class="tech-group-title">@group.Category</h3>
                <div class="tech-badges">
                    @foreach (var tech in group.Items)
                    {
                        <span class="tech-badge">@tech</span>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record TechGroup(string Category, string[] Items);

    protected override void OnInitialized() => LangSvc.OnChange += StateHasChanged;
    public void Dispose() => LangSvc.OnChange -= StateHasChanged;

    private TechGroup[] GetTechGroups() =>
    [
        new(LangSvc.Get("techstack.cat.backend"),       ["C#", ".NET 6/8/10", "ASP.NET Core", "Minimal API", "REST API", "Entity Framework Core", "LINQ", "async/await"]),
        new(LangSvc.Get("techstack.cat.frontend"),      ["Blazor Server", "Blazor WebAssembly", "Razor Components", "MudBlazor", "HTML", "CSS", "JavaScript"]),
        new(LangSvc.Get("techstack.cat.databases"),     ["MS SQL Server", "T-SQL", "SQLite"]),
        new(LangSvc.Get("techstack.cat.authorization"), ["JWT", "ASP.NET Identity", "OpenID Connect", "Microsoft Entra ID", "Microsoft Graph API"]),
        new(LangSvc.Get("techstack.cat.architecture"),  ["Clean Architecture", "SOLID", "OOP"]),
        new(LangSvc.Get("techstack.cat.tools"),         ["Git", "GitLab CI/CD", "Docker", "Postman", "Swagger/OpenAPI", "Visual Studio", "Rider"]),
        new(LangSvc.Get("techstack.cat.cloud"),         ["Azure"]),
    ];
}
